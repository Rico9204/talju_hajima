{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "vite.config.ts"],
  // evaluations.ts는 main의 새 DataRepository 인터페이스(EvaluationAverage 등)와 아직 모양이 안
  // 맞고, 지금은 어디서도 참조되지 않는다(평가 기능은 다음 포팅 대상) — 그 전까지는 제외해둔다.
  "exclude": ["src/api/backend/evaluations.ts"]
}
