# Copy this file to .env.local and fill in the values. .env.local is gitignored.

# Supabase project (Project Settings > API in the Supabase dashboard). The anon key is public by design.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: data.go.kr (odcloud) key for the school -> majors lookup (/api/majors).
# Without it, the major picker cannot load majors. On Vercel, set it as a server-side env var.
ODCLOUD_API_KEY=
