# Copy this file to .env.local and fill in the values. .env.local is gitignored.

# Supabase project (Project Settings > API in the Supabase dashboard). The anon key is public by design.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: data.go.kr (odcloud) key for the school -> majors lookup (/api/majors).
# Without it, the major picker cannot load majors. On Vercel, set it as a server-side env var.
ODCLOUD_API_KEY=

# Optional: 웹 푸시(브라우저를 닫아도 알림). 비워 두면 사이트를 열어 둔 동안의 알림만 동작한다.
# 키 만들기: node -e "const k=require('web-push').generateVAPIDKeys();console.log(k)"  /  비밀값: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vercel에도 같은 값을 넣고 Redeploy. DB에는 push_config에 /api/push 주소와 같은 PUSH_WEBHOOK_SECRET을 넣는다(supabase/migrations/2610011300_web_push.sql 참고).
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-site.example
PUSH_WEBHOOK_SECRET=
