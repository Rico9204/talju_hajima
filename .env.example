# Copy this file to .env.local and fill in the values. .env.local is gitignored.

# Self-hosted API server.
VITE_API_URL=http://localhost:3000/api
# Only when VITE_API_URL is relative (/api, proxied to the API server by vercel.json): the API server origin, no path.
# Realtime (WebSocket) and public file links go there directly, because Vercel rewrites cannot proxy WebSockets.
VITE_BACKEND_URL=

# Optional: data.go.kr (odcloud) key for the school -> majors lookup (/api/majors).
# Without it, the major picker cannot load majors. On Vercel, set it as a server-side env var.
ODCLOUD_API_KEY=
