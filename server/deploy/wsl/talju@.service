# 백엔드 + Cloudflare Tunnel을 한 번에 실행한다(이 PC에서 쓰던 pnpm run dev:cloudflare와 같은 동작).
# %i는 WSL 사용자 이름이다. 설치: sudo cp talju@.service /etc/systemd/system/ && sudo systemctl enable --now talju@$USER
[Unit]
Description=Talju Hajima API + Cloudflare Tunnel
After=network-online.target docker.service
Wants=network-online.target
# Docker Desktop(Windows)을 쓰면 WSL 안에 docker.service가 없다. DB가 늦게 떠도 Restart=always로 다시 시도한다.

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/talju_hajima/server
ExecStart=/usr/bin/node --env-file=.env scripts/dev-cloudflare.mjs
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
