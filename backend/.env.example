NODE_ENV=development
# 로컬 Docker Postgres 기본값. Supabase Postgres를 쓰려면 Supabase 프로젝트의
# Settings > Database > Connection string(URI가 아니라 개별 값) 화면의 Host/Port/User/
# Password/Database로 아래 값을 채우고 DB_SSL=true로 바꾸세요.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=collab_dev
DB_SSL=false
JWT_SECRET=change-me-in-production
# 콤마로 구분된 허용 프론트 출처(예: https://my-app.vercel.app). 비우면 전부 허용(테스트용).
CORS_ORIGIN=
# 학교/학과 검색(GET /majors)용 공공데이터포털 API 키. data.go.kr에서 "학교alri미 대학정보"
# (uddi:d6552229-9686-4565-a421-ab303156f076) 서비스를 신청하면 발급됨 — talju_hajima-main2가
# Vercel에서 쓰던 것과 같은 키를 재사용해도 됨.
ODCLOUD_API_KEY=
# 워드/엑셀/PPT 인앱 편집(OnlyOffice Document Server, docker-compose.yml의 onlyoffice 서비스).
# ONLYOFFICE_INTERNAL_URL: backend가 그 컨테이너로 프록시할 때 쓰는 주소(호스트에 노출된 포트).
# ONLYOFFICE_CALLBACK_BASE_URL: 그 컨테이너가 거꾸로 backend를 부를 때 쓰는 주소 — 컨테이너 안에서는
# localhost가 자기 자신이라 host.docker.internal(Docker Desktop)로 호스트 머신을 가리켜야 함.
# ONLYOFFICE_JWT_SECRET: docker-compose.yml의 onlyoffice.environment.JWT_SECRET과 반드시 같아야 함.
ONLYOFFICE_INTERNAL_URL=http://localhost:8080
ONLYOFFICE_CALLBACK_BASE_URL=http://host.docker.internal:3000
ONLYOFFICE_JWT_SECRET=change-me-in-production
